# BloodConnect Environment Configuration

# Server Port
PORT=5000

# Node Environment: development | production
NODE_ENV=development

# JWT Secret for Auth Token signing
JWT_SECRET=bloodconnect_super_secret_jwt_key_2026_production

# Optional PostgreSQL Connection URL (Leave empty to use built-in zero-config SQLite)
# Example: postgresql://postgres:password@localhost:5432/bloodconnect
DATABASE_URL=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
